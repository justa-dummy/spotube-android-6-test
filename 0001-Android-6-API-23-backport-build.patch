From ce532ffa11c45cb14349552fb15290d4e9390205 Mon Sep 17 00:00:00 2001
From: backport <backport@local>
Date: Sat, 21 Nov 2026 21:32:11 -0700
Subject: [PATCH] Android 6 (API 23) backport build

---
 .cargo/config.toml             |  4 ++
 .github/workflows/android6.yml | 88 ++++++++++++++++++++++++++++++++++
 composeApp/build.gradle.kts    |  2 +
 gradle/libs.versions.toml      |  2 +-
 4 files changed, 95 insertions(+), 1 deletion(-)
 create mode 100644 .cargo/config.toml
 create mode 100644 .github/workflows/android6.yml

diff --git a/.cargo/config.toml b/.cargo/config.toml
new file mode 100644
index 0000000..9cbe02e
--- /dev/null
+++ b/.cargo/config.toml
@@ -0,0 +1,4 @@
+# Android 6 backport: getrandom() only exists in Bionic from Android 9 (API 28).
+# Make the getrandom crate (0.3+) use the raw syscall instead of the libc function.
+[target.armv7-linux-androideabi]
+rustflags = ["--cfg", 'getrandom_backend="linux_raw"']
diff --git a/.github/workflows/android6.yml b/.github/workflows/android6.yml
new file mode 100644
index 0000000..bc55e23
--- /dev/null
+++ b/.github/workflows/android6.yml
@@ -0,0 +1,88 @@
+name: Android 6 build
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+env:
+  COMPOSE_WEBVIEW_REPO: KRTirtho/ComposeNativeWebview
+  COMPOSE_WEBVIEW_COMMIT: b11ac748de1219f9432338c067a2c5dafef3072a
+
+jobs:
+  prepare-deps:
+    name: Prepare compose-webview
+    runs-on: macos-latest
+    steps:
+      - uses: actions/checkout@v7
+        with:
+          repository: ${{ env.COMPOSE_WEBVIEW_REPO }}
+          ref: ${{ env.COMPOSE_WEBVIEW_COMMIT }}
+          path: compose-webview
+      - uses: actions/setup-java@v6
+        with:
+          distribution: temurin
+          java-version: 21
+      - uses: android-actions/setup-android@v4
+      - uses: dtolnay/rust-toolchain@stable
+      - uses: gradle/actions/setup-gradle@v6
+      - name: Publish compose-webview to mavenLocal
+        working-directory: compose-webview
+        run: |
+          chmod +x gradlew
+          ./gradlew publishToMavenLocal
+      - uses: actions/upload-artifact@v7
+        with:
+          name: maven-local
+          path: ~/.m2/repository/
+
+  build-android:
+    name: Android (minSdk 23)
+    needs: prepare-deps
+    timeout-minutes: 150
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/download-artifact@v8
+        with:
+          name: maven-local
+          path: ~/.m2/repository/
+      - uses: actions/setup-java@v6
+        with:
+          distribution: temurin
+          java-version: 21
+      - uses: dtolnay/rust-toolchain@stable
+      - uses: gradle/actions/setup-gradle@v6
+      - run: chmod +x gradlew
+      - name: Assemble (unsigned release)
+        run: ./gradlew :composeApp:assembleStableRelease --stacktrace
+      - name: Check native libraries for Android 7+ symbols
+        if: always()
+        run: |
+          apk=$(find composeApp/build/outputs/apk -name '*.apk' | head -1)
+          [ -n "$apk" ] || exit 0
+          mkdir -p so && unzip -o -q "$apk" 'lib/*' -d so
+          for f in so/lib/*/*.so; do
+            und=$(readelf --dyn-syms -W "$f" | awk '$7=="UND"{print $8}' | sed 's/@.*//' | sort -u)
+            echo "== $f"; echo $und
+            for sym in getrandom getentropy pthread_getattr_np_ aligned_alloc __system_property_read_callback; do
+              grep -qx "$sym" <<< "$und" && echo "::warning::$f imports $sym (needs a newer Android)"
+            done
+          done
+          true
+      - name: Lint for Android 7+ API calls (report only)
+        if: always()
+        continue-on-error: true
+        run: ./gradlew :composeApp:lintStableRelease -Dlint.baselines.continue=true
+      - name: Collect outputs
+        if: always()
+        run: |
+          mkdir -p out
+          find composeApp/build/outputs/apk -name '*.apk' -exec cp {} out/ \; || true
+          find composeApp/build/reports -name 'lint-results*' -exec cp {} out/ \; || true
+      - uses: actions/upload-artifact@v7
+        if: always()
+        with:
+          name: spotube-android6
+          path: out/
diff --git a/composeApp/build.gradle.kts b/composeApp/build.gradle.kts
index a35b110..8e6cc87 100644
--- a/composeApp/build.gradle.kts
+++ b/composeApp/build.gradle.kts
@@ -380,6 +380,8 @@ android {
         targetSdk = libs.versions.android.targetSdk.get().toInt()
         versionCode = appBuildNumber
         versionName = appVersionName
+        // Android 6 backport: only build the 32-bit ARM library (NVIDIA SHIELD Portable)
+        ndk { abiFilters += listOf("armeabi-v7a") }
     }
     // stable = production channel, nightly = beta channel (own icon, name and installable side by side)
     flavorDimensions += "channel"
diff --git a/gradle/libs.versions.toml b/gradle/libs.versions.toml
index 03e7dfd..ba59285 100644
--- a/gradle/libs.versions.toml
+++ b/gradle/libs.versions.toml
@@ -15,7 +15,7 @@
 
 [versions]
 android-compileSdk = "37"
-android-minSdk = "28"
+android-minSdk = "23"
 android-targetSdk = "37"
 agp = "9.1.0"
 androidx-activity = "1.13.0"
